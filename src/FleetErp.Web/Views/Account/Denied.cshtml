@{
    ViewData["Title"] = "Sin permiso";
    Layout = "_LoginLayout";
}

<div class="login">
    <aside class="login__aside">
        <span class="login__mark">FleetERP</span>
        <p class="login__claim">Su cuenta no tiene permiso para esta pantalla.</p>
    </aside>
    <div class="login__panel">
        <div class="login__card">
            <h1>Sin permiso</h1>
            <p class="login__lede">
                El perfil de consulta puede ver los tableros y reportes, pero no capturar movimientos.
                Pida al administrador de su empresa que le asigne el perfil de despachador.
            </p>
            <a class="btn btn--primary" href="/">Volver al tablero</a>
        </div>
    </div>
</div>
