@{
    ViewData["Title"] = "Algo salió mal";
    Layout = "_LoginLayout";
}

<div class="login">
    <aside class="login__aside">
        <span class="login__mark">FleetERP</span>
        <p class="login__claim">La pantalla no se pudo mostrar.</p>
    </aside>
    <div class="login__panel">
        <div class="login__card">
            <h1>Algo salió mal</h1>
            <p class="login__lede">
                Vuelva a intentar en unos momentos. Si el problema sigue, revise que el servicio
                de flotilla (la API) esté encendido y accesible desde este equipo.
            </p>
            <a class="btn btn--primary" href="/">Volver al tablero</a>
        </div>
    </div>
</div>
