@model FuelFormViewModel
@{
    var s = ViewData["Settings"] as TenantSettingsModel ?? TenantSettingsModel.Fallback();
    var search = ViewData["Search"] as string;
}

<form id="detail-form" asp-action="Save" asp-route-search="@search" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="wb__section">
        <h3>Carga</h3>
        <div class="grid grid--form">
            <div class="field">
                <label asp-for="VehicleId"></label>
                <select asp-for="VehicleId" autofocus>
                    <option value="">Seleccione…</option>
                    @foreach (var vehicle in Model.VehicleOptions)
                    {
                        <option value="@vehicle.Id" selected="@(Model.VehicleId == vehicle.Id)">@vehicle.Label</option>
                    }
                </select>
                <span asp-validation-for="VehicleId" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="LoadedAt"></label>
                <input asp-for="LoadedAt" type="datetime-local" />
            </div>
            <div class="field">
                <label asp-for="Quantity"></label>
                <input asp-for="Quantity" type="number" step="0.01" min="0.01" />
                <span class="field__hint">En @Display.VolumeUnitLabel(s).</span>
                <span asp-validation-for="Quantity" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="PricePerUnit"></label>
                <input asp-for="PricePerUnit" type="number" step="0.01" min="0" />
                <span class="field__hint">El importe se calcula solo.</span>
                <span asp-validation-for="PricePerUnit" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="OdometerReading"></label>
                <input asp-for="OdometerReading" type="number" step="0.01" min="0" />
                <span class="field__hint">Si la captura, actualiza el odómetro de la unidad.</span>
            </div>
        </div>
    </div>

    <div class="wb__section">
        <h3>Referencias</h3>
        <div class="grid grid--form">
            <div class="field">
                <label asp-for="TripId"></label>
                <select asp-for="TripId">
                    <option value="">Sin viaje asociado</option>
                    @foreach (var trip in Model.TripOptions)
                    {
                        <option value="@trip.Id" selected="@(Model.TripId == trip.Id)">@trip.Label — @trip.Detail</option>
                    }
                </select>
                <span class="field__hint">Ligarla al viaje permite calcular su rendimiento.</span>
            </div>
            <div class="field">
                <label asp-for="DriverId"></label>
                <select asp-for="DriverId">
                    <option value="">Sin conductor</option>
                    @foreach (var driver in Model.DriverOptions)
                    {
                        <option value="@driver.Id" selected="@(Model.DriverId == driver.Id)">@driver.Label</option>
                    }
                </select>
            </div>
            <div class="field">
                <label asp-for="Station"></label>
                <input asp-for="Station" placeholder="Estación Pemex km 120" />
            </div>
            <div class="field">
                <label asp-for="ReferenceNumber"></label>
                <input asp-for="ReferenceNumber" placeholder="TICKET-00123" />
            </div>
        </div>
    </div>
</form>
