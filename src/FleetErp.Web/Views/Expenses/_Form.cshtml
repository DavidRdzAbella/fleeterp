@model ExpenseFormViewModel
@{
    var search = ViewData["Search"] as string;
}

<form id="detail-form" asp-action="Save" asp-route-search="@search" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="wb__section">
        <h3>Gasto</h3>
        <div class="grid grid--form">
            <div class="field">
                <label asp-for="CategoryId"></label>
                <select asp-for="CategoryId" autofocus>
                    <option value="">Seleccione…</option>
                    @foreach (var category in Model.CategoryOptions)
                    {
                        <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option>
                    }
                </select>
                <span class="field__hint">El combustible se captura en su propio módulo.</span>
                <span asp-validation-for="CategoryId" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="IncurredAt"></label>
                <input asp-for="IncurredAt" type="datetime-local" />
            </div>
            <div class="field">
                <label asp-for="Amount"></label>
                <input asp-for="Amount" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="Amount" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="ReferenceNumber"></label>
                <input asp-for="ReferenceNumber" placeholder="Folio del comprobante" />
            </div>
        </div>

        <div class="field">
            <label asp-for="Description"></label>
            <input asp-for="Description" placeholder="Casetas del tramo Monterrey a Saltillo" />
            <span asp-validation-for="Description" class="field-error"></span>
        </div>
    </div>

    <div class="wb__section">
        <h3>A qué se carga</h3>
        <div class="grid grid--form">
            <div class="field">
                <label asp-for="TripId"></label>
                <select asp-for="TripId">
                    <option value="">Sin viaje asociado</option>
                    @foreach (var trip in Model.TripOptions)
                    {
                        <option value="@trip.Id" selected="@(Model.TripId == trip.Id)">@trip.Label — @trip.Detail</option>
                    }
                </select>
                <span class="field__hint">Amarrarlo al viaje hace que entre a su utilidad.</span>
            </div>
            <div class="field">
                <label asp-for="VehicleId"></label>
                <select asp-for="VehicleId">
                    <option value="">Sin unidad</option>
                    @foreach (var vehicle in Model.VehicleOptions)
                    {
                        <option value="@vehicle.Id" selected="@(Model.VehicleId == vehicle.Id)">@vehicle.Label</option>
                    }
                </select>
            </div>
            <div class="field">
                <label asp-for="DriverId"></label>
                <select asp-for="DriverId">
                    <option value="">Sin conductor</option>
                    @foreach (var driver in Model.DriverOptions)
                    {
                        <option value="@driver.Id" selected="@(Model.DriverId == driver.Id)">@driver.Label</option>
                    }
                </select>
            </div>
        </div>
    </div>
</form>
